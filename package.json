{
  "name": "dreams-mantra",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node index.js",
    "dev:frontend": "cd client && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../client && npm install",
    "build": "node scripts/generate-sitemaps.js && cd client && npm run build",
    "start": "node backend/index.js",
    "serve": "node backend/index.js",
    "open": "npm run build && cd backend && node index.js",
    "generate:sitemaps": "node scripts/generate-sitemaps.js",
    "generate:careers": "node scripts/generateCareers.js",
    "generate:certs": "node scripts/download-all-certs.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "digest-fetch": "^3.1.1"
  }
}
