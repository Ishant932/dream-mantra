PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@dreamsmantra.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=9999999999

# Payments — manual mode by default until gateway is enabled
# Set PAYMENT_GATEWAY_ENABLED=true only when Razorpay keys are configured and tested
PAYMENT_GATEWAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Esh AI (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# CORS (comma-separated, optional)
# CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Dev only: seed sample counselling slots when DB is empty (default true in dev, false in production)
# SEED_SAMPLE_SLOTS=true

# MongoDB Atlas — persistent database (users, payments, bookings, etc.)
# Create free cluster: https://cloud.mongodb.com → Connect → Drivers → copy URI
# Example: mongodb+srv://dreammantra:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/dreammantra?retryWrites=true&w=majority
MONGODB_URI=

# Email (password reset) — pick ONE option below

# Option A — Resend (recommended, free): https://resend.com/api-keys
# RESEND_API_KEY=re_...
# RESEND_FROM=Dream Mantra <onboarding@resend.dev>
# After verifying dreammantra.in domain: Dream Mantra <noreply@dreammantra.in>

# Option B — Gmail SMTP (App Password): https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=dreamz.roadmap@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=Dream Mantra <dreamz.roadmap@gmail.com>

# Legacy aliases (also supported)
# EMAIL_USER=dreamz.roadmap@gmail.com
# EMAIL_PASS=your-app-password
