PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@dreamsmantra.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=9999999999
# Admin WhatsApp alerts (all-tests-complete, etc.) go to ADMIN_PHONE and ADMIN2_PHONE
ADMIN_NAME=Dream Mantra Admin

# Second admin (dual 2FA setup — both QRs shown on first login)
ADMIN2_EMAIL=admin2@dreamsmantra.com
ADMIN2_PASSWORD=Admin@123
ADMIN2_PHONE=9999999998
ADMIN2_NAME=Dream Mantra Admin 2

# Set to true once to reset both admins' Google Authenticator (re-scan QR on next login)
ADMIN_RESET_2FA=false

# Admin login 2FA — set true to require Google Authenticator (off by default)
ADMIN_REQUIRE_2FA=false

# Payments — PhonePe PG (auto-enabled when client id + secret are set)
# Dashboard: https://business.phonepe.com / developer.phonepe.com
# Webhook URL: https://dreammantra.in/api/payments/webhook/phonepe
# Set PAYMENT_GATEWAY_ENABLED=false to force manual UPI + admin verification only
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# SANDBOX for testing, PRODUCTION for live
PHONEPE_ENV=PRODUCTION
# Username + password you configure when adding the webhook in PhonePe dashboard
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Public site URL (used as PhonePe redirect after payment)
APP_PUBLIC_URL=https://dreammantra.in
PAYMENT_GATEWAY_ENABLED=true

# Esh AI (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# CORS (comma-separated, optional)
# CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Counsellor staff logins (5–10+ accounts) — edit backend/data/counsellors.seed.json
# Or set COUNSELLORS_JSON on Render as a JSON array: [{"name":"...","email":"...","phone":"...","password":"..."}]
# Admin can also add/edit counsellors in Admin → Counsellor Staff tab.

# MongoDB Atlas — persistent database (users, payments, bookings, etc.)
# Create free cluster: https://cloud.mongodb.com → Connect → Drivers → copy URI
# Example: mongodb+srv://dreammantra:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/dreammantra?retryWrites=true&w=majority
MONGODB_URI=

# Email OTP (registration + password reset) — pick ONE:

# Option A — Resend (recommended): https://resend.com/api-keys
# RESEND_API_KEY=re_...
# RESEND_FROM=Dream Mantra <onboarding@resend.dev>

# Option B — Gmail SMTP: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=Dream Mantra <your@gmail.com>

# SMS OTP (optional — password reset via mobile)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=+1...

# WhatsApp — Twilio (recommended to start) OR Meta Cloud API
# Full guide: docs/WHATSAPP_SETUP.md

# Provider: twilio (sandbox, no own number needed) | meta (direct Meta API)
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_ENABLED=true
# WHATSAPP_SITE_URL=https://dreammantra.in
# WHATSAPP_DEDUP_HOURS=48

# --- Twilio WhatsApp (free trial + sandbox) ---
# Console: https://console.twilio.com → Messaging → Try WhatsApp
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_SANDBOX=true
# TWILIO_WHATSAPP_SANDBOX_CODE=join word-from-twilio-console
# Optional Content SIDs when you create Twilio templates:
# TWILIO_CONTENT_DM_WELCOME=HX...

# --- Meta Cloud API (alternative — needs business number) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# Secures POST /api/cron/whatsapp (hourly reminder job)
# CRON_SECRET=
